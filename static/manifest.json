{
  "manifest_version": 3,
  "name": "YouTube Tab Grouper 3",
  "description": "Semantically group YouTube video tabs in the current window with a local-first classifier.",
  "version": "0.1.0",
  "minimum_chrome_version": "138",
  "permissions": ["scripting", "sidePanel", "storage", "tabGroups"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "action": { "default_title": "Group YouTube tabs" }
}
